// The Mini Player: the app's own window shrunk to the screen's corner by its native module
// (modules/apple/MiniPlayer.swift), so a Mac's only, drawing the small player in place of the
// sidebar and the pages. The window says back what it is (`miniShown`: mini or full | floating
// or normal | its size).

// A Mac window's size: the sidebar holds every row.
size 1100x800

test "the Mini Player shrinks the window from the player, the mini player and ⌥⌘M, and grows it back" on macos
  request POST "/__mock/reset" as reader
  clock data
  type "server" "http://127.0.0.1:13378"
  type "username" "reader"
  type "password" "listen"
  tap "sign-in-button"
  clock data
  clock settle
  tap "continue-li_dune"
  clock data
  clock settle
  tap "play"
  clock data
  clock settle
  clock +600 real
  tap "play-pause"
  clock +300 real
  expect state paused == true
  expect state miniWindow == false
  expect state miniShown == "full|normal|1100x852"
  tap "player-mini-window"
  clock +500 real
  expect state miniWindow == true
  expect state miniShown == "mini|normal|440x136"
  expect text "mini-window-title" == "Dune"
  expect text "mini-elapsed" == "0:45"
  tap "mini-forward-30"
  clock +300 real
  expect text "mini-elapsed" == "1:15"
  expect state track == 1
  tap "mini-back-30"
  clock +300 real
  expect text "mini-elapsed" == "0:45"
  tap "mini-next-chapter"
  clock +300 real
  expect text "mini-window-detail" == "Book Three: The Prophet — Frank Herbert"
  tap "mini-prev-chapter"
  clock +300 real
  expect text "mini-window-detail" == "Book Two: Muad’Dib — Frank Herbert"
  tap "mini-float"
  clock +300 real
  expect state miniFloating == true
  expect state miniShown == "mini|floating|440x136"
  tap "mini-window-play-pause"
  clock +300 real
  expect state paused == false
  tap "mini-window-play-pause"
  clock +300 real
  expect state paused == true
  tap "mini-expand"
  clock +300 real
  expect state miniWindow == false
  expect state miniShown == "full|normal|1100x852"
  back
  clock settle
  type "root" key "Control+Meta+s"
  clock settle
  tap "mini-window-button"
  clock +300 real
  expect state miniWindow == true
  expect state miniShown == "mini|floating|440x136"
  type "mini-window-play-pause" key "Alt+Meta+m"
  clock +300 real
  expect state miniWindow == false
  expect state miniShown == "full|normal|1100x852"
