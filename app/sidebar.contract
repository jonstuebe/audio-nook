// Audio Nook's sidebar, drawn after macOS 26's (Music, Podcasts, Books): a search field, Listen Now
// and Downloads, then Libraries, Browse and Playlists under headers that fold, a card for the book
// that is playing, and the account at the foot. It is the root's tablist, so each tab row still
// names its panel and the app's routes keep a stack per row; app.contract places it and answers
// every row through `go`. Exact's own sidebar (AppKit's source list) draws rows only, so this one
// is the app's: its glass, its selection, its fold and its width.
use CollectionCard from "./library.contract"

// A server library; the sidebar is handed it with `icon` already its symbol (librarySymbol).
shape Library
  id: string
  name: string
  icon: string

// An Audiobookshelf library's icon (the web client's `libraryIcons`) as the symbol Music would
// draw for it; anything else is the books on a shelf.
fn librarySymbol(icon: string): string = (icon == "database" ? "symbol:icon.lib-database"
  : icon == "headphones" ? "symbol:icon.headphones"
  : icon == "book-1" or icon == "books-2" ? "symbol:book"
  : icon == "microphone-1" or icon == "microphone-3" ? "symbol:microphone"
  : icon == "radio" ? "symbol:icon.lib-radio"
  : icon == "podcast" ? "symbol:icon.lib-podcast"
  : icon == "rss" ? "symbol:icon.lib-rss"
  : icon == "music" ? "symbol:icon.lib-music"
  : icon == "file-picture" ? "symbol:photo"
  : icon == "rocket" ? "symbol:sparkles"
  : icon == "power" ? "symbol:icon.lib-power"
  : icon == "star" ? "symbol:star"
  : icon == "heart" ? "symbol:heart"
  : "symbol:icon.books-vertical")

// One row: a tinted glyph, a title and, when there is one, a count; the selected row on a pill.
component SidebarRow
  props
    symbol: string
    title: string
    count: number
    selected: bool
    testId: string
  view
    row flex=1 gap=8 align-items="center" height=28 padding="0 8px" min-width=0 border-radius=8
      background-color=(selected ? "sidebar.selection" : "transparent")
      image symbol font-size=15 font-weight=300 width=20 text-align="center" color="AccentColor" aria-hidden=true testId=`${testId}-icon`
      text title flex=1 min-width=0 text-align="left" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
        font="-exact-body" font-weight=(selected ? 600 : 400) color=(selected ? "AccentColor" : "-exact-label")
      if count > 0
        text `${count}` font="-exact-subheadline" font-variant-numeric="tabular-nums" color="-exact-secondary-label" testId=`${testId}-count`

// A section's header: its name in small secondary type, and a chevron, shown under the pointer,
// that folds the section, as Finder's and Music's do.
component SectionHeader
  props
    title: string
    open: bool
    toggle: action
    testId: string
  state over = false
  action hovered(on: bool)
    over = on
  view
    row press=toggle hover=hovered role="button" tabindex=0 aria-label=`${title}, ${open ? "expanded" : "collapsed"}` aria-expanded=open
      align-items="center" gap=4 height=26 padding="10px 10px 0 18px" testId=testId
      text title flex=1 font="-exact-caption1" font-weight=600 color="-exact-secondary-label"
      image "symbol:icon.chevron-down" font-size=10 color="-exact-secondary-label" rotate=(open ? "0deg" : "-90deg")
        opacity=(over ? 1 : 0) transition="rotate 160ms ease-out" aria-hidden=true testId=`${testId}-chevron`

component Sidebar
  props
    open: bool
    width: number
    query: string
    current: string
    libraries: Library[]
    playlists: CollectionCard[]
    inProgress: number
    downloaded: number
    librariesOpen: bool
    browseOpen: bool
    playlistsOpen: bool
    playing: bool
    nowTitle: string
    nowAuthor: string
    nowCover: string
    nowFraction: number
    paused: bool
    username: string
    host: string
    search: action
    submitSearch: action
    go: action
    keyed: action
    toggleSection: action
    toggle: action
    openPlayer: action
    copyServer: action
    signOut: action
    resize: action
  view
    column aria-label="Sidebar" display=(open ? "flex" : "none") position="relative" width=width flex-shrink=0 margin="0 0 8px 8px"
      backgroundMaterial="glass" border-radius=16 overflow="hidden" testId="sidebar"
      // The search field, drawn as AppKit's: a magnifier, 6 points, then the text, and a clear
      // button once there is some. (Exact's own NSSearchField sets its text over the magnifier.)
      row margin="14px 10px 10px" height=28 padding="0 6px 0 8px" gap=6 align-items="center" border-radius=999
        background-color="sidebar.field" testId="search-box"
        image "symbol:search" font-size=13 color="-exact-secondary-label" aria-hidden=true
        input type="search" appearance="none" id="search-field" value=query input=search submit=submitSearch placeholder="Search"
          aria-label="Search" flex=1 min-width=0 font="-exact-body" testId="search"
        if query != ""
          button press=search("") appearance="none" display="flex" align-items="center" justify-content="center" width=18 height=18
            aria-label="Clear Search" color="-exact-secondary-label" testId="search-clear"
            image "symbol:close" font-size=11
      // The rows: the root's tablist, every tab its direct child so each names its panel.
      scroll role="tablist" aria-label="Audio Nook" aria-orientation="vertical" appearance="none" key=keyed flex=1 min-height=0 testId="sidebar-rows"
        // Search's panel has a tab too, unseen: the field above stands for it.
        button role="tab" aria-controls="panel-search" aria-selected=(current == "search") press=go("search") display="none" testId="tab-search"
          text "Search"
        button role="tab" aria-controls="panel-home" aria-selected=(current == "home") press=go("home") aria-keyshortcuts="Meta+1"
          appearance="none" display="flex" width=(width - 20) margin="0 10px" border-radius=8 testId="tab-home"
          :hover
            background-color="sidebar.hover"
          SidebarRow(symbol="symbol:icon.headphones", title="Listen Now", count=inProgress, selected=(current == "home"), testId="row-home")
        button role="tab" aria-controls="panel-downloads" aria-selected=(current == "downloads") press=go("downloads") aria-keyshortcuts="Meta+3"
          appearance="none" display="flex" width=(width - 20) margin="0 10px" border-radius=8 testId="tab-downloads"
          :hover
            background-color="sidebar.hover"
          SidebarRow(symbol="symbol:download", title="Downloads", count=downloaded, selected=(current == "downloads"), testId="row-downloads")
        SectionHeader(title="Libraries", open=librariesOpen, toggle=toggleSection("libraries"), testId="section-libraries")
        for l, i in libraries key=l.id
          button role="tab" aria-controls=`panel-library-${l.id}` aria-selected=(current == `lib:${l.id}`) press=go(`lib:${l.id}`)
            aria-keyshortcuts=(i < 6 ? `Meta+${i + 4}` : "") display=(librariesOpen ? "flex" : "none")
            appearance="none" width=(width - 20) margin="0 10px" border-radius=8 testId=`tab-library-${l.id}`
            :hover
              background-color="sidebar.hover"
            SidebarRow(symbol=l.icon, title=l.name, count=0, selected=(current == `lib:${l.id}`), testId=`row-library-${l.id}`)
        SectionHeader(title="Browse", open=browseOpen, toggle=toggleSection("browse"), testId="section-browse")
        for b in ["series", "authors", "collections"] key=b
          button press=go(b) aria-pressed=(current == b) display=(browseOpen ? "flex" : "none")
            appearance="none" width=(width - 20) margin="0 10px" border-radius=8 testId=`browse-${b}`
            :hover
              background-color="sidebar.hover"
            SidebarRow(symbol=(b == "series" ? "symbol:layers" : b == "authors" ? "symbol:people" : "symbol:icon.collections"),
              title=(b == "series" ? "Series" : b == "authors" ? "Authors" : "Collections"), count=0, selected=(current == b), testId=`row-browse-${b}`)
        if playlists.length > 0
          SectionHeader(title="Playlists", open=playlistsOpen, toggle=toggleSection("playlists"), testId="section-playlists")
        for p in playlists key=p.id
          button role="tab" aria-controls=`panel-playlist-${p.id}` aria-selected=(current == `pl:${p.id}`) press=go(`pl:${p.id}`)
            display=(playlistsOpen ? "flex" : "none")
            appearance="none" width=(width - 20) margin="0 10px" border-radius=8 testId=`tab-playlist-${p.id}`
            :hover
              background-color="sidebar.hover"
            SidebarRow(symbol="symbol:icon.playlist", title=p.name, count=p.count, selected=(current == `pl:${p.id}`), testId=`row-playlist-${p.id}`)
      // The book that is playing: the card opens Now Playing; its button plays and pauses.
      if playing
        column margin="4px 10px 6px" padding=8 gap=8 border-radius=12 background-color="sidebar.selection" testId="now-card"
          row press=openPlayer role="button" tabindex=0 aria-label=`Now Playing: ${nowTitle}` gap=8 align-items="center" testId="now-card-open"
            image nowCover alt="" width=36 height=36 border-radius=6 object-fit="cover"
            column flex=1 min-width=0 gap=1
              text nowTitle font="-exact-subheadline" font-weight=600 white-space="nowrap" text-overflow="ellipsis" overflow="hidden" testId="now-card-title"
              text nowAuthor font="-exact-caption1" color="-exact-secondary-label" white-space="nowrap" text-overflow="ellipsis" overflow="hidden" testId="now-card-author"
            button press=toggle appearance="none" display="flex" align-items="center" justify-content="center" width=28 height=28 border-radius=999
              aria-label=(paused ? "Play" : "Pause") color="-exact-label" testId="now-card-play"
              :hover
                background-color="sidebar.hover"
              image (paused ? "symbol:play-fill" : "symbol:pause-fill") font-size=15
          row height=3 border-radius=999 background-color="sidebar.selection" overflow="hidden" aria-hidden=true
            column width=`${max(0, min(1, nowFraction)) * 100}%` background-color="-exact-secondary-label" border-radius=999 testId="now-card-progress"
      // The account: who is signed in where, and its menu.
      button popovertarget="account-menu" appearance="none" display="flex" width=(width - 20) min-width=0 overflow="hidden" margin="0 10px 10px" padding="6px 8px" border-radius=8
        aria-label=`Account: ${username} on ${host}` testId="account"
        :hover
          background-color="sidebar.hover"
        row flex=1 gap=8 align-items="center" min-width=0
          column width=24 height=24 border-radius=999 background-color="AccentColor" align-items="center" justify-content="center"
            text (username == "" ? "?" : username.slice(0, 1).toUpperCase()) font="-exact-caption1" font-weight=700 color="#ffffff"
          column flex=1 min-width=0 align-items="stretch"
            text (username == "" ? "Signed In" : username) font="-exact-subheadline" font-weight=500 text-align="left" white-space="nowrap" text-overflow="ellipsis" overflow="hidden" testId="account-name"
            text host font="-exact-caption2" color="-exact-secondary-label" text-align="left" white-space="nowrap" text-overflow="ellipsis" overflow="hidden" testId="account-host"
          image "symbol:chooser" font-size=11 color="-exact-secondary-label" aria-hidden=true
      column id="account-menu" popover="auto" role="menu" aria-label="Account"
        button press=copyServer popovertarget="account-menu" popovertargetaction="hide" testId="account-copy"
          image "symbol:copy"
          text "Copy Server Address"
        button press=signOut popovertarget="account-menu" popovertargetaction="hide" testId="sign-out"
          image "symbol:sign-out"
          text "Sign Out"
      // The edge a drag widens or narrows it by.
      column position="absolute" top=0 right=0 bottom=0 width=6 pan=resize cursor="col-resize" aria-hidden=true testId="sidebar-edge"
