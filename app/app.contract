// Audio Nook: an Audiobookshelf client. app.ts talks to the server; this file is the view, its
// state and what each action changes. Signed out, the app is the sign-in form; signed in, a
// library that pushes an item's detail, which pushes the player. The audio element lives beside
// the screens, so a book keeps playing while you browse.
use EmptyState from "exact:content"
use Book, BookPage, DownloadInfo, SeriesCard, AuthorCard, CollectionCard, Shelf, Home, AuthorPage, SeriesEntry, SeriesPage, CollectionPage, Choice from "./library.contract"
use clockText, lengthText, progressText, percentText, booksText, dlState, dlProgress, dlError from "./library.contract"
use LargeTitle, BookGrid, BookList, SeriesBooks, SeriesGrid, AuthorGrid, CollectionGrid, ShelfRow, AuthorPhoto from "./library.contract"

// Three sidebar sections: Listen Now, Search, and the library a library row chose. A book's
// detail and the player push onto whichever is showing.
routes nav
  tab home "/"
    item "/item/:id"
    player "/player"
    author "/author/:id"
    series "/series/:id"
    collection "/collection/:id"
  tab search "/search"
  tab downloads "/downloads"
  tab library "/library"

shape Session
  signedIn: bool
  server: string
  username: string
  ended: bool

shape Reply
  ok: bool
  error: string

shape Library
  id: string
  name: string

shape Chapter
  id: number
  title: string
  start: number
  end: number

shape Author
  id: string
  name: string

shape SearchResults
  query: string
  books: Book[]
  authors: Author[]

shape DownloadStep
  ok: bool
  error: string
  finished: bool

shape Pending
  count: number

shape SeriesRef
  id: string
  name: string

shape Detail
  id: string
  title: string
  author: string
  narrator: string
  description: string
  cover: string
  duration: number
  progress: number
  currentTime: number
  chapters: Chapter[]

shape Track
  index: number
  startOffset: number
  duration: number
  path: string

shape PlaySession
  id: string
  itemId: string
  title: string
  author: string
  cover: string
  duration: number
  currentTime: number
  chapters: Chapter[]
  tracks: Track[]

fn trackAt(tracks: Track[], at: number): number = max(0, tracks.filter(t => t.startOffset <= at).length - 1)
fn offsetOf(tracks: Track[], i: number): number = match tracks.at(i) { case some(t) => t.startOffset, case none => 0 }
fn urlOf(urls: string[], i: number): string = match urls.at(i) { case some(u) => u, case none => "" }
fn chapterAt(chapters: Chapter[], at: number): number = max(0, chapters.filter(c => c.start <= at + 0.5).length - 1)
fn chapterTitle(chapters: Chapter[], i: number): string = match chapters.at(i) { case some(c) => c.title, case none => "" }
fn chapterStart(chapters: Chapter[], i: number): number = match chapters.at(i) { case some(c) => c.start, case none => 0 }
fn rateText(r: number): string = `${r}×`
// Which panel shows a tab's stack: a library's own for the library tab.
fn holds(panel: string, tab: string, library: string): bool = tab == "library" ? panel == `library-${library}` : panel == tab
fn nameOf(libraries: Library[], id: string): string = libraries.filter(l => l.id == id).map(l => l.name).join("")

component App
  // The sign-in form; the server's address is remembered for the next sign-in.
  state server = "" persist
  state username = ""
  state password = ""
  state libraryId = "" persist
  state query = ""
  // A library's page: books, series, authors or collections; books as a grid or a list, in an
  // order, filtered; and how many pages of books have been asked for.
  state libraryView = "books" persist
  state layout = "grid" persist
  state sortKey = "title" persist
  state filterKey = "all" persist
  state pages = 1
  // The book a right-click opened the menu on.
  state aimed: option<Book> = none
  // The player: which track plays, where in it, and where to go once it has loaded.
  state paused = true
  state track = 0
  state at = 0
  state pendingSeek = 0
  // A seek the element hasn't finished: its time updates until then are from before it.
  state seeking = false
  state rate = 1
  state lastSynced = 0
  // Renewals of the access token the audio URLs carry, and whether this load has already tried one.
  state tokenGen = 0
  // The Mini Player window (the Mac's own panel, modules/apple/MiniPlayer.swift): whether it is
  // open, whether it floats above other apps, and, under the agent, what it says it shows.
  state miniWindow = false
  state miniFloating = false persist
  state miniShown = ""
  state mediaRetried = false

  resource session = session() as shape Session else empty()
  // "" while signed out, so a sign-in (even to the same server) asks every resource again.
  derive api = session.signedIn ? session.server : ""
  resource libraries = libraries(api) as shape Library[] else empty()
  derive currentLibrary = libraries.filter(l => l.id == libraryId).length > 0 ? libraryId : match first(libraries) { case some(l) => l.id, case none => "" }
  resource page = libraryItems(api, currentLibrary, sortKey, filterKey, pages * 24) as shape BookPage else empty()
  derive books = page.books
  resource home = home(api, currentLibrary) as shape Home else empty()
  // Each of a library's other views is asked for only while it shows.
  resource seriesCards = seriesList(api, libraryView == "series" ? currentLibrary : "") as shape SeriesCard[] else empty()
  resource authorCards = authors(api, libraryView == "authors" ? currentLibrary : "") as shape AuthorCard[] else empty()
  resource collectionCards = collections(api, libraryView == "collections" ? currentLibrary : "") as shape CollectionCard[] else empty()
  derive selectedAuthor = match stack(nav).filter(e => e.name == "author").at(-1) { case some(e) => e.params.id, case none => "" }
  derive selectedSeries = match stack(nav).filter(e => e.name == "series").at(-1) { case some(e) => e.params.id, case none => "" }
  derive selectedCollection = match stack(nav).filter(e => e.name == "collection").at(-1) { case some(e) => e.params.id, case none => "" }
  resource authorPage = author(api, selectedAuthor) as shape AuthorPage else empty()
  resource seriesPage = series(api, currentLibrary, selectedSeries) as shape SeriesPage else empty()
  resource collectionPage = collection(api, selectedCollection) as shape CollectionPage else empty()
  derive sortChoices = [Choice(key="title", label="Title"), Choice(key="author", label="Author"), Choice(key="added", label="Recently Added"), Choice(key="progress", label="Progress")]
  derive filterChoices = [Choice(key="all", label="All Books"), Choice(key="in-progress", label="In Progress"), Choice(key="finished", label="Finished"), Choice(key="not-started", label="Not Started"), Choice(key="downloaded", label="Downloaded")]
  derive filterLabel = filterChoices.filter(c => c.key == filterKey).map(c => c.label).join("")
  derive selected = match stack(nav).filter(e => e.name == "item").at(-1) { case some(e) => e.params.id, case none => "" }
  resource detail = itemDetail(api, selected) as shape Detail else empty()
  derive panels = ["home", "search", "downloads"].concat(libraries.map(l => `library-${l.id}`))
  resource results = search(api, currentLibrary, query) as shape SearchResults else empty()

  mutation loggedIn as shape Reply refreshes session, libraries, page, home, detail
  mutation loggedOut as shape Reply refreshes session
  mutation started as shape PlaySession then afterStart
  mutation synced as shape Reply queue refreshes pending
  mutation closed as shape Reply queue refreshes home, page, detail, pending, downloads
  // Downloads: what is kept, one track fetched per step, and progress waiting for the server.
  resource downloads = downloads(api) as shape DownloadInfo[] else empty()
  resource pending = pendingSync(api) as shape Pending else empty()
  mutation dlStarted as shape Reply refreshes downloads
  mutation dlStepped as shape DownloadStep refreshes downloads
  mutation dlRemoved as shape Reply refreshes downloads
  mutation flushed as shape Pending refreshes pending, home, page
  derive activeDownload = match first(downloads.filter(d => d.state == "downloading")) { case some(d) => d.id, case none => "" }
  derive keptBooks = downloads.map(d => Book(id=d.id, title=d.title, author=d.author, cover=d.cover, duration=d.duration, progress=d.listened, series=""))
  mutation renewed as shape Reply then afterRenew
  // A book's context menu: finished or not, and its series.
  mutation finishedSet as shape Reply refreshes home, page, detail, seriesPage, authorPage, collectionPage, results
  mutation seriesFound as shape SeriesRef then afterSeriesFound
  derive aimedId = match aimed { case some(b) => b.id, case none => "" }
  derive aimedFinished = match aimed { case some(b) => b.progress >= 1, case none => false }
  derive aimedSeries = match aimed { case some(b) => b.series, case none => "" }

  derive loginError = match loggedIn { case some(r) => r.error, case none => "" }
  derive playing = match started { case some(s) => s.id != "", case none => false }
  derive sessionId = match started { case some(s) => s.id, case none => "" }
  derive tracks = match started { case some(s) => s.tracks, case none => [] }
  derive chapters = match started { case some(s) => s.chapters, case none => [] }
  derive duration = match started { case some(s) => s.duration, case none => 0 }
  derive nowTitle = match started { case some(s) => s.title, case none => "" }
  derive nowAuthor = match started { case some(s) => s.author, case none => "" }
  derive nowCover = match started { case some(s) => s.cover, case none => "" }
  derive nowItem = match started { case some(s) => s.itemId, case none => "" }
  resource media = trackUrls(tracks.map(t => t.path), tokenGen) as shape string[] else empty()
  derive position = offsetOf(tracks, track) + at
  // A refresh the server refused (app.ts forgot the sign-in): any read that met it shows the form.
  derive librariesCode = match failure(libraries) { case some(f) => f.code, case none => "" }
  derive booksCode = match failure(page) { case some(f) => f.code, case none => "" }
  derive continuingCode = match failure(home) { case some(f) => f.code, case none => "" }
  derive detailCode = match failure(detail) { case some(f) => f.code, case none => "" }
  derive renewSignedOut = match renewed { case some(rr) => rr.error == "signed-out", case none => false }
  derive sessionEnded = session.ended or (session.signedIn and not pending(loggedIn) and (librariesCode == "signed-out" or booksCode == "signed-out" or continuingCode == "signed-out" or detailCode == "signed-out" or renewSignedOut))
  derive showSignIn = not session.signedIn or sessionEnded
  derive chapter = chapterAt(chapters, position)

  // A download moves a track per step while one is in progress.
  task fetchTracks when activeDownload != ""
    every(250, pumpDownload)
  // Progress kept while offline goes to the server as soon as it answers.
  task sendQueued when pending.count > 0 and session.signedIn
    every(30000, flushNow)

  // Every 15 s of playback the server hears where we are (ABS's own clients sync about as often).
  task sync when playing and not paused
    every(15000, syncNow)

  action editServer(v: string)
    server = v
  action editUsername(v: string)
    username = v
  action editPassword(v: string)
    password = v
  action signIn
    if not pending(loggedIn)
      send loggedIn = login(server, username, password)
      password = ""
  action signOut
    stopPlayback()
    send loggedOut = logout()
    nav = open(nav, "/")
    server = session.server

  // A library's row in the sidebar: that library, at its root.
  action showLibrary(id: string)
    libraryId = id
    pages = 1
    nav = select(nav, "library")
  action showTab(name: string)
    nav = select(nav, name)
  action searchFor(v: string)
    query = v
  action openBookMenu(b: Book)
    aimed = some(b)
  action menuPlay
    if aimedId != ""
      play(aimedId)
  action menuDownload
    if aimedId != ""
      download(aimedId)
  action menuRemoveDownload
    if aimedId != ""
      removeKept(aimedId)
  action menuFinish
    if aimedId != ""
      send finishedSet = markFinished(aimedId, not aimedFinished)
  action menuShowSeries
    if aimedId != ""
      send seriesFound = findSeries(aimedId)
  action afterSeriesFound
    match seriesFound
      case some(found)
        if found.id != ""
          nav = push(nav, path("series", found.id))
      case none
        paused = paused
  // ⌘F: the Search page, its field focused.
  action findInLibrary
    nav = select(nav, "search")
    focus("search-field")
  action showView(v: string)
    libraryView = v
  action setSort(k: string)
    sortKey = k
    pages = 1
  action setFilter(k: string)
    filterKey = k
    pages = 1
  action toggleLayout
    layout = layout == "grid" ? "list" : "grid"
  // The next page of books, when the end of what is shown comes into view (or More is pressed).
  action loadMore
    if books.length < page.total and not pending(page)
      pages = pages + 1
  action back
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)
  action openPlayer
    nav = top(nav).name == "player" ? nav : push(nav, "/player")

  action play(id: string)
    if nowItem == id
      paused = false
      openPlayer()
    else
      closeCurrent()
      paused = true
      send started = startPlayback(id)
  action afterStart
    match started
      case some(s)
        let t = trackAt(s.tracks, s.currentTime)
        let local = s.currentTime - offsetOf(s.tracks, t)
        track = t
        at = local
        pendingSeek = local
        seeking = true
        lastSynced = s.currentTime
        paused = false
        nav = top(nav).name == "player" ? nav : push(nav, "/player")
      case none
        paused = true

  action toggle
    let next = not paused
    paused = next
    if not next
      syncNow()
  action hostPaused
    paused = true
  action hostPlaying
    paused = false
  action ticked(t: number)
    if not seeking
      at = t
  action loaded
    mediaRetried = false
    fastSeek("player-audio", pendingSeek)
  // Audio that stops loading may be an expired access token in its URL: renew once and load
  // the same place again with the new one.
  action mediaFailed(message: string)
    if not mediaRetried and not pending(renewed)
      mediaRetried = true
      pendingSeek = at
      seeking = true
      send renewed = renewToken()
  action afterRenew
    match renewed
      case some(rr)
        if rr.ok
          tokenGen = tokenGen + 1
        else
          paused = true
      case none
        paused = true
  action seekDone
    seeking = false
  action trackEnded
    if track + 1 < tracks.length
      track = track + 1
      at = 0
      pendingSeek = 0
      seeking = false
    else
      paused = true
      syncNow()

  // Seeking is in the book's time; the track that holds it plays from there.
  action seek(to: number)
    let target = max(0, min(to, duration - 0.25))
    let t = trackAt(tracks, target)
    let local = target - offsetOf(tracks, t)
    at = local
    pendingSeek = local
    seeking = true
    if t == track
      fastSeek("player-audio", local)
    else
      track = t
  action skip(by: number)
    seek(position + by)
  action scrubbed(v: number)
    seek(v)
  action previousChapter
    // Within the first few seconds of a chapter, Previous goes to the one before; else to its start.
    seek(position - chapterStart(chapters, chapter) < 3 ? chapterStart(chapters, max(0, chapter - 1)) : chapterStart(chapters, chapter))
  action nextChapter
    if chapter + 1 < chapters.length
      seek(chapterStart(chapters, chapter + 1))
  action setRate(v: string)
    rate = match parseNumber(v) { case some(n) => n, case none => 1 }

  action syncNow
    if sessionId != ""
      send synced = syncSession(sessionId, position, max(0, min(position - lastSynced, 60)), duration)
      lastSynced = position
  action closeCurrent
    if sessionId != ""
      send closed = closeSession(sessionId, position, max(0, min(position - lastSynced, 60)), duration)
  action stopPlayback
    closeCurrent()
    paused = true
    started = none
    track = 0
    at = 0
  action stopAndClose
    stopPlayback()
    nav = back(nav)

  action download(id: string)
    if not pending(dlStarted)
      send dlStarted = startDownload(id)
  action pumpDownload
    if activeDownload != "" and not pending(dlStepped)
      send dlStepped = downloadNext(activeDownload)
  action removeKept(id: string)
    send dlRemoved = removeDownload(id)
  action flushNow
    if not pending(flushed)
      send flushed = flushProgress()

  // Window ▸ Mini Player (⌥⌘M), and the buttons on the mini player and the player.
  action toggleMiniWindow
    miniWindow = not miniWindow
  // What the Mini Player window's controls say: the same actions as the main player's.
  action onMini(message: string)
    if message == "toggle"
      toggle()
    else if message == "back30"
      skip(-30)
    else if message == "forward30"
      skip(30)
    else if message == "previous"
      previousChapter()
    else if message == "next"
      nextChapter()
    else if message == "float:on"
      miniFloating = true
    else if message == "float:off"
      miniFloating = false
    else if message == "closed"
      miniWindow = false
    else if message.startsWith("seek:")
      seek(match parseNumber(message.slice(5)) { case some(n) => n, case none => position })
    else if message.startsWith("shown:")
      miniShown = message.slice(6)

  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow
      width="100%" height="100%" display="flex" flex-direction="column"
      if showSignIn
        SignIn(server=server, username=username, password=password, error=(sessionEnded and loginError == "" ? "Your session has ended. Sign in again." : loginError), busy=pending(loggedIn),
          editServer=editServer, editUsername=editUsername, editPassword=editPassword, signIn=signIn)
      // The panels: one per sidebar row. A library's routes live in its own panel, so the
      // sidebar marks the row of the library they show.
      column flex=1 min-height=0 position="relative" display=(showSignIn ? "none" : "flex")
        for p in panels key=p
          column role="tabpanel" id=`panel-${p}` position="absolute" inset=0
            for t in nav.tabs.filter(t => holds(p, t.name, currentLibrary)) key=t.name
              for e in t.stack key=e.id
                if e.name == "home"
                  column navigationKey=`${e.id}` navigationScroll=`scroll-${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
                    header display="flex" align-items="center" gap=8 padding="8px 16px"
                      text "Listen Now" role="heading" aria-level=1 flex=1
                      button press=signOut aria-label="Sign Out" testId="sign-out"
                        image "symbol:sign-out"
                    scroll id=`scroll-${e.id}` flex=1 min-height=0
                      column gap=32 padding="28px 32px 120px"
                        LargeTitle(title="Listen Now", subtitle=session.username == "" ? session.server : `${session.username} · ${session.server}`)
                        if failed(home)
                          EmptyState(symbol="symbol:alert", title="Can’t Reach the Server", message=`Couldn’t load your books from ${session.server}.`)
                            button press=showTab("downloads") testId="home-offline-downloads"
                              text "Go to Downloads"
                        else if home.shelves.length == 0 and pending(home)
                          column align-items="center" padding="48px 0" testId="home-loading"
                            progress aria-label="Loading"
                        else if home.shelves.length == 0
                          EmptyState(symbol="symbol:icon.headphones", title="Nothing Here Yet", message="Books in this library appear here once it has some.")
                            button press=showLibrary(currentLibrary) testId="empty-browse"
                              text "Browse the Library"
                        else
                          for sh in home.shelves key=sh.id
                            ShelfRow(shelf=sh, downloads=downloads, menu=openBookMenu, playNow=play)
                if e.name == "search"
                  column navigationKey=`${e.id}` navigationScroll=`scroll-${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
                    header display="flex" align-items="center" gap=8 padding="8px 16px"
                      text "Search" role="heading" aria-level=1 flex=1
                      input type="search" id="search-field" value=query input=searchFor placeholder=`Search ${nameOf(libraries, currentLibrary)}` aria-label="Search" testId="search"
                    scroll id=`scroll-${e.id}` flex=1 min-height=0
                      column gap=28 padding="28px 32px 120px"
                        LargeTitle(title="Search", subtitle=nameOf(libraries, currentLibrary))
                        if query.trim() == ""
                          EmptyState(symbol="symbol:search", title="Search Your Library", message="Find books by title, or authors by name.")
                        else if failed(results)
                          EmptyState(symbol="symbol:alert", title="Search Didn’t Work", message="The server didn’t answer. Try again.")
                        else if results.query == query.trim() and results.books.length == 0 and results.authors.length == 0 and not pending(results)
                          EmptyState(symbol="symbol:search", title=`No Results for “${query.trim()}”`, message="Check the spelling or try a new search.")
                        else
                          if results.authors.length > 0
                            column gap=10
                              text "Authors" font="-exact-title2" font-weight=700
                              row gap=10 flex-wrap="wrap"
                                for a in results.authors key=a.id
                                  row gap=6 align-items="center" padding="6px 12px" border-radius=999 background-color="-exact-secondary-fill"
                                    image "symbol:person" color="-exact-secondary-label"
                                    text a.name testId=`author-${a.id}`
                          if results.books.length > 0
                            column gap=14
                              text "Books" font="-exact-title2" font-weight=700
                              BookGrid(books=results.books, prefix="result", downloads=downloads, menu=openBookMenu, playNow=play)
                if e.name == "library"
                  column navigationKey=`${e.id}` navigationScroll=`scroll-${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
                    // The toolbar: the library's title, its four views as segments, and for books the
                    // layout, Sort and Filter (each a menu).
                    header display="flex" align-items="center" gap=8 padding="8px 16px"
                      text nameOf(libraries, currentLibrary) role="heading" aria-level=1 flex=1
                      row role="tablist" aria-label="View"
                        button role="tab" aria-selected=(libraryView == "books") press=showView("books") testId="view-books"
                          text "Books"
                        button role="tab" aria-selected=(libraryView == "series") press=showView("series") testId="view-series"
                          text "Series"
                        button role="tab" aria-selected=(libraryView == "authors") press=showView("authors") testId="view-authors"
                          text "Authors"
                        button role="tab" aria-selected=(libraryView == "collections") press=showView("collections") testId="view-collections"
                          text "Collections"
                      if libraryView == "books"
                        button press=toggleLayout aria-label=(layout == "grid" ? "Show as List" : "Show as Grid") testId="layout-button"
                          image (layout == "grid" ? "symbol:list" : "symbol:icon.grid")
                        button popovertarget="sort-menu" aria-label="Sort" testId="sort-button"
                          image "symbol:sort"
                        button popovertarget="filter-menu" aria-label="Filter" testId="filter-button"
                          image (filterKey == "all" ? "symbol:filter" : "symbol:icon.filter-on")
                    scroll id=`scroll-${e.id}` flex=1 min-height=0
                      column gap=28 padding="28px 32px 120px"
                        if libraryView == "series"
                          LargeTitle(title="Series", subtitle=nameOf(libraries, currentLibrary))
                          if failed(seriesCards)
                            EmptyState(symbol="symbol:alert", title="Can’t Load Series", message="The server didn’t answer.")
                          else if seriesCards.length == 0 and pending(seriesCards)
                            column align-items="center" padding="48px 0"
                              progress aria-label="Loading"
                          else if seriesCards.length == 0
                            EmptyState(symbol="symbol:layers", title="No Series", message="Books that belong to a series are grouped here.")
                          else
                            SeriesGrid(series=seriesCards, prefix="series")
                        else if libraryView == "authors"
                          LargeTitle(title="Authors", subtitle=nameOf(libraries, currentLibrary))
                          if failed(authorCards)
                            EmptyState(symbol="symbol:alert", title="Can’t Load Authors", message="The server didn’t answer.")
                          else if authorCards.length == 0 and pending(authorCards)
                            column align-items="center" padding="48px 0"
                              progress aria-label="Loading"
                          else if authorCards.length == 0
                            EmptyState(symbol="symbol:people", title="No Authors", message="This library has no authors yet.")
                          else
                            AuthorGrid(authors=authorCards, prefix="author")
                        else if libraryView == "collections"
                          LargeTitle(title="Collections", subtitle=nameOf(libraries, currentLibrary))
                          if failed(collectionCards)
                            EmptyState(symbol="symbol:alert", title="Can’t Load Collections", message="The server didn’t answer.")
                          else if collectionCards.length == 0 and pending(collectionCards)
                            column align-items="center" padding="48px 0"
                              progress aria-label="Loading"
                          else if collectionCards.length == 0
                            EmptyState(symbol="symbol:bookmark", title="No Collections", message="Collections made on the server appear here.")
                          else
                            CollectionGrid(collections=collectionCards)
                        else
                          LargeTitle(title=nameOf(libraries, currentLibrary), subtitle=(pending(page) and books.length == 0 ? "" : filterKey == "all" ? booksText(page.total) : `${booksText(page.total)} · ${filterLabel}`))
                          if failed(page)
                            EmptyState(symbol="symbol:alert", title="Can’t Load the Library", message=`Couldn’t reach ${session.server}.`)
                              button press=signOut testId="failed-sign-out"
                                text "Sign Out"
                          else if books.length == 0 and pending(page)
                            column align-items="center" padding="48px 0" testId="library-loading"
                              progress aria-label="Loading"
                          else if books.length == 0 and filterKey != "all"
                            EmptyState(symbol="symbol:filter", title=`No ${filterLabel} Books`, message="Try another filter.")
                              button press=setFilter("all") testId="filter-clear"
                                text "Show All Books"
                          else if books.length == 0 and not pending(libraries)
                            EmptyState(symbol="symbol:book", title="No Books", message="This library has no items yet.")
                          else
                            if layout == "list"
                              BookList(books=books, prefix="book", downloads=downloads, menu=openBookMenu, playNow=play)
                            else
                              BookGrid(books=books, prefix="book", downloads=downloads, menu=openBookMenu, playNow=play)
                            // More as the end comes into view; the button for a reader who would rather press.
                            if books.length < page.total
                              view intersect=loadMore height=1 testId="more-marker"
                              row justify-content="center"
                                button press=loadMore disabled=pending(page) testId="load-more"
                                  text (pending(page) ? "Loading…" : `Show More (${page.total - books.length} more)`)
                    column id="sort-menu" popover="auto" role="menu" aria-label="Sort"
                      for c in sortChoices key=c.key
                        button press=setSort(c.key) popovertarget="sort-menu" popovertargetaction="hide" role="menuitemradio" aria-checked=(sortKey == c.key) testId=`sort-${c.key}`
                          text c.label
                    column id="filter-menu" popover="auto" role="menu" aria-label="Filter"
                      for c in filterChoices key=c.key
                        button press=setFilter(c.key) popovertarget="filter-menu" popovertargetaction="hide" role="menuitemradio" aria-checked=(filterKey == c.key) testId=`filter-${c.key}`
                          text c.label
                if e.name == "author"
                  column navigationKey=`${e.id}` navigationScroll=`scroll-${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
                    header display="flex" align-items="center" padding="8px 16px"
                      button id="back" press=back aria-label="Back"
                        image "symbol:back"
                      text (authorPage.id == e.params.id ? authorPage.name : "") role="heading" aria-level=2
                    scroll id=`scroll-${e.id}` flex=1 min-height=0
                      if failed(authorPage)
                        EmptyState(symbol="symbol:alert", title="Can’t Load This Author", message="The server didn’t answer.")
                      else if authorPage.id != e.params.id
                        column align-items="center" padding="48px 0"
                          progress aria-label="Loading"
                      else
                        column gap=28 padding="32px 32px 120px" max-width="64rem"
                          row gap=28 align-items="center" flex-wrap="wrap"
                            AuthorPhoto(name=authorPage.name, image=authorPage.image, size=160)
                            column gap=6 flex=1 flex-basis="18rem" min-width=0
                              text authorPage.name font="-exact-large-title" font-weight=700 testId="author-title"
                              text booksText(authorPage.books.length) color="-exact-secondary-label" testId="author-count"
                              text (authorPage.description == "" ? "" : authorPage.description) line-height=1.45 testId="author-bio"
                          if authorPage.series.length > 0
                            column gap=14
                              text "Series" font="-exact-title2" font-weight=700
                              SeriesGrid(series=authorPage.series, prefix="authorseries")
                          column gap=14
                            text "Books" font="-exact-title2" font-weight=700
                            BookGrid(books=authorPage.books, prefix="authorbook", downloads=downloads, menu=openBookMenu, playNow=play)
                if e.name == "series"
                  column navigationKey=`${e.id}` navigationScroll=`scroll-${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
                    header display="flex" align-items="center" padding="8px 16px"
                      button id="back" press=back aria-label="Back"
                        image "symbol:back"
                      text (seriesPage.id == e.params.id ? seriesPage.name : "") role="heading" aria-level=2
                    scroll id=`scroll-${e.id}` flex=1 min-height=0
                      if failed(seriesPage)
                        EmptyState(symbol="symbol:alert", title="Can’t Load This Series", message="The server didn’t answer.")
                      else if seriesPage.id != e.params.id
                        column align-items="center" padding="48px 0"
                          progress aria-label="Loading"
                      else
                        column gap=28 padding="28px 32px 120px"
                          LargeTitle(title=seriesPage.name, subtitle=booksText(seriesPage.entries.length))
                          SeriesBooks(entries=seriesPage.entries, downloads=downloads, menu=openBookMenu, playNow=play)
                if e.name == "collection"
                  column navigationKey=`${e.id}` navigationScroll=`scroll-${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
                    header display="flex" align-items="center" padding="8px 16px"
                      button id="back" press=back aria-label="Back"
                        image "symbol:back"
                      text (collectionPage.id == e.params.id ? collectionPage.name : "") role="heading" aria-level=2
                    scroll id=`scroll-${e.id}` flex=1 min-height=0
                      if failed(collectionPage)
                        EmptyState(symbol="symbol:alert", title="Can’t Load This Collection", message="The server didn’t answer.")
                      else if collectionPage.id != e.params.id
                        column align-items="center" padding="48px 0"
                          progress aria-label="Loading"
                      else
                        column gap=28 padding="28px 32px 120px"
                          LargeTitle(title=collectionPage.name, subtitle=(collectionPage.description == "" ? booksText(collectionPage.books.length) : `${booksText(collectionPage.books.length)} · ${collectionPage.description}`))
                          BookGrid(books=collectionPage.books, prefix="collectionbook", downloads=downloads, menu=openBookMenu, playNow=play)
                if e.name == "downloads"
                  column navigationKey=`${e.id}` navigationScroll=`scroll-${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
                    header display="flex" align-items="center" gap=8 padding="8px 16px"
                      text "Downloads" role="heading" aria-level=1 flex=1
                    scroll id=`scroll-${e.id}` flex=1 min-height=0
                      column gap=28 padding="28px 32px 120px"
                        LargeTitle(title="Downloads", subtitle=(pending.count > 0 ? `${pending.count} ${pending.count == 1 ? "book's" : "books’"} progress waiting to sync` : "Books you can listen to without a connection"))
                        if downloads.length == 0 and not pending(downloads)
                          EmptyState(symbol="symbol:download", title="No Downloads", message="Download a book from its page to listen without a connection.")
                        else
                          BookGrid(books=keptBooks, prefix="download", downloads=downloads, menu=openBookMenu, playNow=play)
                if e.name == "item"
                  column navigationKey=`${e.id}` navigationScroll=`scroll-${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
                    header display="flex" align-items="center" padding="8px 16px"
                      button id="back" press=back aria-label="Back"
                        image "symbol:back"
                      text (detail.id == e.params.id ? detail.title : "") role="heading" aria-level=2 testId="detail-heading"
                    if failed(detail)
                      EmptyState(symbol="symbol:alert", title="Can’t Load This Book", message="The server didn’t answer.")
                    else
                      scroll id=`scroll-${e.id}` flex=1 min-height=0
                        if detail.id == e.params.id
                          ItemDetail(item=detail, play=play(detail.id), starting=pending(started), isCurrent=(nowItem == detail.id), seekChapter=seek,
                            dlState=dlState(downloads, detail.id), dlProgress=dlProgress(downloads, detail.id), dlError=dlError(downloads, detail.id),
                            download=download(detail.id), removeDownload=removeKept(detail.id), starts=pending(dlStarted))
                if e.name == "player"
                  column navigationKey=`${e.id}` navigationScroll=`scroll-${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
                    header display="flex" align-items="center" padding="8px 16px"
                      button id="back" press=back aria-label="Back"
                        image "symbol:back"
                      text "Now Playing" role="heading" aria-level=2 flex=1
                      button press=toggleMiniWindow aria-label=(miniWindow ? "Close Mini Player" : "Open Mini Player") testId="player-mini-window"
                        image "symbol:icon.mini-player"
                      button press=stopAndClose aria-label="Stop" testId="stop"
                        image "symbol:stop"
                    if playing
                      scroll id=`scroll-${e.id}` flex=1 min-height=0
                        column align-items="center" gap=18 padding="32px 32px 48px" max-width="36rem" margin="0 auto"
                          image nowCover alt=nowTitle width=280 height=280 border-radius=14 object-fit="cover"
                            box-shadow="0 12px 32px rgba(0, 0, 0, 0.25)" testId="player-cover"
                          column align-items="center" gap=4 width="100%"
                            text nowTitle font="-exact-title1" font-weight=700 text-align="center" testId="player-title"
                            text nowAuthor font="-exact-title3" color="-exact-secondary-label" text-align="center" testId="player-author"
                            text chapterTitle(chapters, chapter) color="-exact-secondary-label" text-align="center" testId="player-chapter"
                          column gap=4 width="100%"
                            input type="range" min=0 max=duration step=1 value=position change=scrubbed aria-label="Position" testId="scrubber"
                            row justify-content="space-between"
                              text clockText(position) font="-exact-caption1" font-variant-numeric="tabular-nums" color="-exact-secondary-label" testId="elapsed"
                              text `-${clockText(max(0, duration - position))}` font="-exact-caption1" font-variant-numeric="tabular-nums" color="-exact-secondary-label" testId="remaining"
                          row gap=14 align-items="center" justify-content="center" flex-wrap="wrap" padding="10px 16px"
                            glassGroup=14
                            button press=previousChapter buttonStyle="glass" aria-label="Previous Chapter" testId="prev-chapter"
                              image "symbol:icon.backward-end-fill" font-size=20
                            button press=skip(-30) buttonStyle="glass" aria-label="Back 30 Seconds" testId="back-30"
                              image "symbol:skip-back-30" font-size=24
                            button press=toggle buttonStyle="prominent-glass" aria-label=(paused ? "Play" : "Pause") testId="play-pause"
                              image (paused ? "symbol:play-fill" : "symbol:pause-fill") font-size=34
                            button press=skip(30) buttonStyle="glass" aria-label="Forward 30 Seconds" testId="forward-30"
                              image "symbol:skip-forward-30" font-size=24
                            button press=nextChapter buttonStyle="glass" aria-label="Next Chapter" disabled=(chapter + 1 >= chapters.length) testId="next-chapter"
                              image "symbol:icon.forward-end-fill" font-size=20
                          row gap=8 align-items="center" flex-wrap="wrap"
                            text "Speed" color="-exact-secondary-label"
                            select value=rate.toString() change=setRate aria-label="Speed" testId="speed"
                              for r in ["0.75", "1", "1.25", "1.5", "1.75", "2"] key=r
                                option `${r}×` value=r
                            text (paused ? "Paused" : "Playing") font="-exact-footnote" color="-exact-secondary-label" testId="play-state"
                          if chapters.length > 0
                            column gap=0 width="100%" padding-top=8
                              text "Chapters" font="-exact-title3" font-weight=700 padding-bottom=6
                              for c in chapters key=c.id
                                row press=seek(c.start) role="button" tabindex=0 aria-label=c.title gap=10 padding="9px 10px" border-radius=8
                                  background-color=(c.id == chapter ? "-exact-secondary-fill" : "transparent") testId=`chapter-${c.id}`
                                  text c.title flex=1 min-width=0 font-weight=(c.id == chapter ? 600 : 400)
                                  text clockText(c.start) font-variant-numeric="tabular-nums" color="-exact-secondary-label"
                    else
                      EmptyState(symbol="symbol:play", title="Nothing Playing", message="Choose a book and press Play.")
        // A mini player in glass over the page while a book plays and the player isn't shown.
        if playing and top(nav).name != "player"
          row position="absolute" bottom=16 left=16 right=16 max-width="40rem" margin="0 auto"
            backgroundMaterial="glass" border-radius=18 padding="8px 12px" gap=12 align-items="center" testId="mini-player"
            row press=openPlayer role="button" tabindex=0 aria-label=`Now Playing: ${nowTitle}` gap=10 align-items="center" flex=1 min-width=0 testId="mini-open"
              image nowCover alt="" width=40 height=40 border-radius=6 object-fit="cover"
              column flex=1 min-width=0 gap=1
                text nowTitle font="-exact-subheadline" font-weight=600 white-space="nowrap" text-overflow="ellipsis" overflow="hidden" testId="mini-title"
                text chapterTitle(chapters, chapter) font="-exact-footnote" color="-exact-secondary-label" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
            button press=skip(-30) buttonStyle="glass" aria-label="Back 30 Seconds" testId="mini-back-30"
              image "symbol:skip-back-30"
            button press=toggle buttonStyle="prominent-glass" aria-label=(paused ? "Play" : "Pause") testId="mini-play-pause"
              image (paused ? "symbol:play-fill" : "symbol:pause-fill")
            button press=skip(30) buttonStyle="glass" aria-label="Forward 30 Seconds" testId="mini-forward-30"
              image "symbol:skip-forward-30"
            button press=toggleMiniWindow buttonStyle="glass" aria-label=(miniWindow ? "Close Mini Player" : "Open Mini Player") testId="mini-window-button"
              image "symbol:icon.mini-player"
      // The sidebar (AppKit's source list on a Mac, a sidebar in a wide browser window).
      row role="tablist" aria-label="Audio Nook" display=(showSignIn ? "none" : "flex")
        button role="tab" aria-controls="panel-home" aria-selected=(nav.tab == "home") press=showTab("home") aria-keyshortcuts="Meta+1" testId="tab-home" flex=1
          image "symbol:icon.headphones"
          text "Listen Now"
        button role="tab" aria-controls="panel-search" aria-selected=(nav.tab == "search") press=showTab("search") aria-keyshortcuts="Meta+2" testId="tab-search" flex=1
          image "symbol:search"
          text "Search"
        button role="tab" aria-controls="panel-downloads" aria-selected=(nav.tab == "downloads") press=showTab("downloads") aria-keyshortcuts="Meta+3" testId="tab-downloads" flex=1
          image "symbol:download"
          text "Downloads"
        for l, i in libraries key=l.id
          button role="tab" aria-controls=`panel-library-${l.id}` aria-selected=(nav.tab == "library" and currentLibrary == l.id)
            press=showLibrary(l.id) aria-keyshortcuts=(i < 6 ? `Meta+${i + 4}` : "") testId=`tab-library-${l.id}` flex=1
            image "symbol:icon.books-vertical"
            text l.name
      // The one player, beside the screens so it keeps playing while you browse.
      if playing and not showSignIn and urlOf(media, track) != ""
        audio urlOf(media, track) id="player-audio" paused=paused playbackRate=rate
          timeupdate=ticked loadedmetadata=loaded error=mediaFailed seeked=seekDone ended=trackEnded pause=hostPaused playing=hostPlaying
          metadata=MediaMetadata(title=nowTitle, artist=nowAuthor, album=chapterTitle(chapters, chapter), artwork=nowCover)
          seekbackwardOffset=30 seekforwardOffset=30 seekbackward=skip(-30) seekforward=skip(30)
          previoustrack=previousChapter nexttrack=nextChapter
          width=0 height=0 position="absolute" testId="player-audio"
      // The Mini Player window: a 1-point anchor here, the window AppKit's.
      nook-mini-player id="mini-window" testId="mini-window" position="absolute" width=1 height=1
        open=(miniWindow and playing and not showSignIn ? "true" : "false") floating=(miniFloating ? "true" : "false")
        bookTitle=nowTitle author=nowAuthor chapter=chapterTitle(chapters, chapter) cover=nowCover
        seconds=`${round(position)}` duration=`${duration}` elapsed=clockText(position) remaining=`-${clockText(max(0, duration - position))}`
        state=(paused ? "paused" : "playing") hasNext=(chapter + 1 < chapters.length ? "true" : "false")
        message=onMini
      // Menu bar commands (the Mac files them in its menus; elsewhere they are plain buttons, kept out of sight).
      row position="absolute" width="0.0625rem" height="0.0625rem" overflow="hidden" opacity=0
        button press=toggleMiniWindow -exact-menu="window" aria-keyshortcuts="Alt+Meta+M" disabled=(not playing)
          aria-label=(miniWindow ? "Close Mini Player" : "Mini Player") testId="menu-mini-player"
          text (miniWindow ? "Close Mini Player" : "Mini Player")
        button press=toggle -exact-menu="view dock" disabled=(not playing) aria-label=(paused ? "Play" : "Pause") testId="menu-play-pause"
          text (paused ? "Play" : "Pause")
        button press=skip(-30) -exact-menu="view dock" aria-keyshortcuts="Meta+ArrowLeft" disabled=(not playing) aria-label="Skip Back 30 Seconds" testId="menu-back-30"
          text "Skip Back 30 Seconds"
        button press=skip(30) -exact-menu="view dock" aria-keyshortcuts="Meta+ArrowRight" disabled=(not playing) aria-label="Skip Forward 30 Seconds" testId="menu-forward-30"
          text "Skip Forward 30 Seconds"
        button press=previousChapter -exact-menu="view" aria-keyshortcuts="Alt+Meta+ArrowLeft" disabled=(not playing) aria-label="Previous Chapter" testId="menu-previous-chapter"
          text "Previous Chapter"
        button press=nextChapter -exact-menu="view" aria-keyshortcuts="Alt+Meta+ArrowRight" disabled=(not playing or chapter + 1 >= chapters.length) aria-label="Next Chapter" testId="menu-next-chapter"
          text "Next Chapter"
        button press=findInLibrary aria-keyshortcuts="Meta+F" aria-label="Find in Library" testId="menu-find"
          text "Find in Library"
        // Space plays and pauses, as in Music, except on the Search page, where it types.
        if playing and nav.tab != "search"
          button press=toggle -exact-menu="none" aria-keyshortcuts="Space" aria-label="Play or Pause" testId="key-space"
            text "Play or Pause"
      // A book's menu, on a right-click of its cover or row.
      column id="book-menu" popover="auto" role="menu" aria-label="Book"
        button press=menuPlay popovertarget="book-menu" popovertargetaction="hide" testId="menu-book-play"
          image "symbol:play-fill"
          text "Play"
        if dlState(downloads, aimedId) == "done"
          button press=menuRemoveDownload popovertarget="book-menu" popovertargetaction="hide" testId="menu-book-download"
            image "symbol:delete"
            text "Remove Download"
        else if dlState(downloads, aimedId) == "downloading"
          button press=menuRemoveDownload popovertarget="book-menu" popovertargetaction="hide" testId="menu-book-download"
            image "symbol:close"
            text "Cancel Download"
        else
          button press=menuDownload popovertarget="book-menu" popovertargetaction="hide" testId="menu-book-download"
            image "symbol:download"
            text "Download"
        button press=menuFinish popovertarget="book-menu" popovertargetaction="hide" testId="menu-book-finish"
          image "symbol:checkmark"
          text (aimedFinished ? "Mark as Not Finished" : "Mark as Finished")
        button press=menuShowSeries disabled=(aimedSeries == "") popovertarget="book-menu" popovertargetaction="hide" testId="menu-book-series"
          image "symbol:layers"
          text (aimedSeries == "" ? "Show in Series" : `Show in ${aimedSeries}`)

component SignIn
  props
    server: string
    username: string
    password: string
    error: string
    busy: bool
    editServer: action
    editUsername: action
    editPassword: action
    signIn: action
  view
    column width="100%" height="100%" display="flex" flex-direction="column"
      header display="flex" align-items="center" padding="8px 16px"
        text "Audio Nook" role="heading" aria-level=1
      scroll flex=1 min-height=0
        column align-items="center" gap=6 padding="48px 24px 8px"
          image "symbol:icon.headphones" font-size=44 color="AccentColor"
          text "Sign In to Audiobookshelf" font="-exact-title1" font-weight=700 text-align="center"
          text "Enter your server’s address and your account." color="-exact-secondary-label" text-align="center"
        list appearance="auto" listStyle="inset-grouped" max-width="30rem" width="100%" margin="0 auto" testId="sign-in"
          section
            header
              text "Server"
            row
              input value=server input=editServer placeholder="http://192.168.1.10:13378" aria-label="Server Address"
                autocapitalize="none" inputmode="url" flex=1 min-width=0 testId="server"
          section
            header
              text "Account"
            row
              input value=username input=editUsername placeholder="Username" aria-label="Username" autocapitalize="none"
                autocomplete="username" flex=1 min-width=0 testId="username"
            row
              input type="password" value=password input=editPassword submit=signIn placeholder="Password" aria-label="Password"
                autocomplete="current-password" flex=1 min-width=0 testId="password"
            footer
              text (error != "" and not busy ? error : busy ? "Signing in…" : "") color=(error != "" and not busy ? "-exact-system-red" : "-exact-secondary-label") testId="sign-in-message"
          section
            button press=signIn disabled=(busy or server.trim() == "" or username.trim() == "") testId="sign-in-button"
              text "Sign In"

component ItemDetail
  props
    item: Detail
    play: action
    starting: bool
    isCurrent: bool
    seekChapter: action
    dlState: string
    dlProgress: number
    dlError: string
    download: action
    removeDownload: action
    starts: bool
  view
    column gap=28 padding="32px 32px 120px" max-width="56rem"
      row gap=32 align-items="flex-end" flex-wrap="wrap"
        image item.cover alt=item.title width=220 height=220 border-radius=10 object-fit="cover"
          box-shadow="0 10px 28px rgba(0, 0, 0, 0.22)" testId="detail-cover"
        column gap=6 flex=1 flex-basis="16rem" min-width=0
          text item.title font="-exact-large-title" font-weight=700 testId="detail-title"
          text `By ${item.author}` font="-exact-title3" testId="detail-author"
          text (item.narrator == "" ? "" : `Narrated by ${item.narrator}`) color="-exact-secondary-label" testId="detail-narrator"
          text `${lengthText(item.duration)} · ${item.chapters.length} ${item.chapters.length == 1 ? "chapter" : "chapters"} · ${progressText(item.progress)}` color="-exact-secondary-label" testId="detail-meta"
          row padding-top=12 gap=10 flex-wrap="wrap" align-items="center"
            button press=play disabled=starting buttonStyle="filled" testId="play"
              image "symbol:play-fill"
              text (starting ? "Starting…" : isCurrent ? "Resume" : item.currentTime > 0 ? "Continue" : "Play")
            if dlState == "done"
              row gap=6 align-items="center"
                image "symbol:download" color="-exact-secondary-label"
                text "Downloaded" color="-exact-secondary-label" testId="download-state"
              button press=removeDownload destructive=true testId="download-delete"
                text "Remove Download"
            else if dlState == "downloading"
              row gap=8 align-items="center"
                progress value=dlProgress max=1 width="8rem" testId="download-progress"
                text `Downloading ${percentText(dlProgress)}` color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="download-state"
              button press=removeDownload testId="download-cancel"
                text "Cancel"
            else
              button press=download disabled=starts buttonStyle="bordered" testId="download"
                image "symbol:download"
                text (starts ? "Preparing…" : dlState == "failed" ? "Try Download Again" : "Download")
          if dlState == "failed"
            text dlError color="-exact-system-red" font="-exact-footnote" testId="download-error"
      column gap=8
        text "About" font="-exact-title3" font-weight=700
        text item.description line-height=1.45 testId="detail-description"
      column gap=0
        text "Chapters" font="-exact-title3" font-weight=700 padding-bottom=6
        for c in item.chapters key=c.id
          column
            row gap=8 padding="9px 0" testId=`detail-chapter-${c.id}`
              text `${c.id + 1}` color="-exact-secondary-label" font-variant-numeric="tabular-nums" width="2rem"
              text c.title flex=1 min-width=0
              text clockText(c.end - c.start) font-variant-numeric="tabular-nums" color="-exact-secondary-label"
            hr
